{
  "name": "smilevista-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css --minify",
    "build:js": "node scripts/build.mjs",
    "build": "npm run build:css && npm run build:js",
    "dev": "npm run build && node server/server.js",
    "start": "node server/server.js",
    "start:build": "npm run build && node server/server.js",
    "postinstall": "node scripts/init-env.mjs && npm run build",
    "setup:email": "node scripts/setup-email.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.6.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.1",
    "preact": "^10.29.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^3.0.1",
    "react-router-dom": "^6.14.2",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.14",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "uuid": "^11.1.1",
    "tar": "^7.5.11"
  }
}
